[node name="BedDialog" parent="." unique_id=1832516139 instance=ExtResource("6_obk76")]
position = Vector2(556, 93)
text = PackedStringArray(". . .", "I am [b][i]so[/i][/b] tired.", "[color=#8c8c8c]\"Could you just please stay late?\\nWe have an important deadline.\"[/color]\\nThere is [b][i]always[/i][/b] an important deadline.", "There will never [b][i]not[/i][/b] be an important deadline.", ". . .", "I would quit, but then, what?\\nLook for a job?\\nIn [i]this[/i] economy?", "I wish I could just . . .", ". . . magically be young again,\\nfull of hope and energy.")
